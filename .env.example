# ===== Citadel IA — copie para .env e preencha. Detalhes de cada variável: VARIAVEIS_AMBIENTE.md =====
APP_ENV=production
DOMAIN=citadel.example.com
TAG=latest
ACME_EMAIL=infra@suaempresa.com.br
APP_UID=                            # make keys preenche com UID do usuário que executa o deploy
APP_GID=                            # make keys preenche com GID do usuário que executa o deploy

# Banco / cache / objetos
POSTGRES_PASSWORD=troque-me            # openssl rand -hex 24
APP_DB_PASSWORD=troque-me              # senha do papel citadel_app (sem BYPASSRLS)
REDIS_PASSWORD=troque-me
S3_ACCESS_KEY=citadel
S3_SECRET_KEY=troque-me-com-32-caracteres
S3_BUCKET=citadel

# Criptografia: `make keys` preenche os campos vazios diretamente no .env, sem mostrar os valores.
# NUNCA reutilize entre ambientes e faça backup seguro.
KEK_HEX=                               # 64 hex (32 bytes): protege as chaves de dados por empresa
HMAC_KEY_HEX=                          # 64 hex: índice cego do CPF, URLs assinadas
IA_CORE_API_KEY=                       # chave API -> IA Core
IA_CALLBACK_SECRET=                    # HMAC do callback IA Core -> API

# Acesso inicial
MASTER_EMAIL=master@suaempresa.com.br
MASTER_PASSWORD=                       # `make keys` gera se vazio; usada só na primeira execução do seed
SEED_DEMO=false

# E-mail (2FA, convites, alertas)
MAIL_DRIVER=smtp
SMTP_HOST=smtp.suaempresa.com.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Citadel IA <nao-responda@suaempresa.com.br>
COMMERCIAL_EMAIL=comercial@suaempresa.com.br

# IA: sem chave nenhuma = motor local. Com chave, imagens e textos das páginas difíceis saem para o provedor: valide o tratamento de dados reais antes.
# Com as duas chaves, a OpenAI tem prioridade; IA_PROVIDER=openai|gemini|local força a escolha.
IA_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_FALLBACK=gpt-5
OPENAI_MODEL_LITE=gpt-5-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# Opcionais
MAX_UPLOAD_MB=500
WORKER_CONCURRENCY=4
BATCH_STALL_SECONDS=180
CAPTCHA_SECRET=
CORS_ORIGINS=
