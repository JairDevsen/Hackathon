# Copie para ia-core/.env.local e preencha a chave apenas na sua máquina.
# O arquivo real é ignorado pelo Git. Não use dados reais com uma chave de protótipo.
#
# Escolha UM provedor de IA. Sem nenhuma chave, o IA Core usa o motor local (texto nativo, OCR e regras).
# Com as duas chaves preenchidas, a OpenAI tem prioridade. IA_PROVIDER=openai|gemini|local força a escolha.
IA_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_FALLBACK=gpt-5
OPENAI_MODEL_LITE=gpt-5-nano
# Opcional, só para modelos que aceitam (minimal|low|medium|high): reduz o tempo de resposta.
# OPENAI_REASONING_EFFORT=minimal

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
